INVERTER_IP=192.168.1.70

# InfluxDB is available on port 8086, e.g. http://localhost:8086
INFLUX_TOKEN=mytoken
INFLUX_ORG=myorg
INFLUX_BUCKET=mybucket
INFLUX_USER=admin
INFLUX_PASSWORD=admin123!

# Grafana is available on port 3000, e.g. http://localhost:3000
# Default user is admin, change the password below
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
