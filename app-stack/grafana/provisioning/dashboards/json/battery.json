{
  "title": "Battery",
  "uid": "battery",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "__inputs": [],
  "__requires": [],
  "panels": [
    {
      "title": "Current Charge",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "yellow", "value": 40 },
              { "color": "green", "value": 60 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB" },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"inverter\")\n  |> filter(fn: (r) => r._field == \"battery_soc\")\n  |> last()",
          "refId": "A"
        }
      ],
      "datasource": { "type": "influxdb", "uid": "InfluxDB" }
    },
    {
      "title": "Battery",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 12 },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "battery_soc" },
            "properties": [
              { "id": "displayName", "value": "State of Charge (%)" },
              { "id": "unit", "value": "percent" },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 },
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineWidth", "value": 1 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p_battery" },
            "properties": [
              { "id": "displayName", "value": "Battery Power (W)" },
              { "id": "unit", "value": "watt" },
              { "id": "min", "value": -3600 },
              { "id": "max", "value": 3600 },
              { "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } },
              { "id": "custom.fillOpacity", "value": 20 },
              { "id": "custom.fillBelowTo", "value": "0" },
              { "id": "custom.lineWidth", "value": 1 }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB" },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"inverter\")\n  |> filter(fn: (r) => r._field == \"battery_soc\")",
          "refId": "A"
        },
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB" },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"inverter\")\n  |> filter(fn: (r) => r._field == \"p_battery\")",
          "refId": "B"
        }
      ],
      "datasource": { "type": "influxdb", "uid": "InfluxDB" }
    },
    {
      "title": "Power Movement",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": { "mode": "none" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p_combined_generation" },
            "properties": [
              { "id": "displayName", "value": "PV Generation (W)" },
              { "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p_grid_out" },
            "properties": [
              { "id": "displayName", "value": "Power to Grid (W)" },
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p_load_demand" },
            "properties": [
              { "id": "displayName", "value": "House Load (W)" },
              { "id": "color", "value": { "fixedColor": "white", "mode": "fixed" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB" },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"inverter\")\n  |> filter(fn: (r) => r._field == \"p_combined_generation\")",
          "refId": "A"
        },
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB" },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"inverter\")\n  |> filter(fn: (r) => r._field == \"p_grid_out\")",
          "refId": "B"
        },
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB" },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"inverter\")\n  |> filter(fn: (r) => r._field == \"p_load_demand\")",
          "refId": "C"
        }
      ],
      "datasource": { "type": "influxdb", "uid": "InfluxDB" }
    }
  ],
  "templating": {
    "list": []
  }
}
