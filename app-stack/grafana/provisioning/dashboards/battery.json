{
  "title": "Battery",
  "uid": "battery",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "__inputs": [],
  "__requires": [],
  "panels": [
    {
      "title": "Battery",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 12 },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "battery_soc" },
            "properties": [
              { "id": "displayName", "value": "State of Charge (%)" },
              { "id": "unit", "value": "percent" },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 },
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineWidth", "value": 2 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p_battery" },
            "properties": [
              { "id": "displayName", "value": "Battery Power (W)" },
              { "id": "unit", "value": "watt" },
              { "id": "min", "value": -3600 },
              { "id": "max", "value": 3600 },
              { "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } },
              { "id": "custom.fillOpacity", "value": 20 },
              { "id": "custom.fillBelowTo", "value": "0" },
              { "id": "custom.lineWidth", "value": 2 }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB" },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"inverter\")\n  |> filter(fn: (r) => r._field == \"battery_soc\")",
          "refId": "A"
        },
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB" },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"inverter\")\n  |> filter(fn: (r) => r._field == \"p_battery\")",
          "refId": "B"
        }
      ],
      "datasource": { "type": "influxdb", "uid": "InfluxDB" }
    }
  ],
  "templating": {
    "list": []
  }
}
